# --- DIV Game Studio install: NOT committed, only Oleg's own original files under it ---
/DIV/*
!/DIV/PRG/
/DIV/PRG/*
!/DIV/PRG/Olegs/
!/DIV/PRG/GAMES/
/DIV/PRG/GAMES/*
!/DIV/PRG/GAMES/EFFEKTE.PRG
!/DIV/FPG/
/DIV/FPG/*
!/DIV/FPG/Olegs/
!/DIV/FNT/
/DIV/FNT/*
!/DIV/FNT/Olegs/
!/DIV/FNT/BALLKILL.FNT
!/DIV/FNT/NEW_FONT.FNT
!/DIV/MAP/
/DIV/MAP/*
!/DIV/MAP/*.MAP
!/DIV/PAL/
/DIV/PAL/*
!/DIV/PAL/MANDBROT.PAL
!/DIV/Saves/
!/DIV/DAT/
/DIV/DAT/*
!/DIV/DAT/*.DAT

# --- Godot ---
.godot/
# keep *.import and *.uid files: the projects need them
*.translation
export_credentials.cfg

# --- Website build output (_web) ---
/_web/dist/
.wrangler/
# Web exports written by each game's "Web" preset (index.html/js/pck/wasm.br/...)
/_web/public/*/
!/_web/public/img/
# generated by build_index.py
/_web/public/index.html
/_web/public/img/div-games-studio.png

# --- Tools / OS / editors ---
node_modules/
__pycache__/
*.py[cod]
.env
.env.*
*.tmp
*.log
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Desktop export builds, if anyone makes them
*.exe
*.pck
*.zip

# Stray empty scripts at the root (the root is not a Godot project)
/*.gd
