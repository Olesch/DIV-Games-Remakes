[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/options_panel.gd" id="1"]

[sub_resource type="StyleBoxFlat" id="panel_style"]
bg_color = Color(0.04, 0.05, 0.1, 0.92)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.55, 0.6, 0.8, 1)
content_margin_left = 20.0
content_margin_top = 16.0
content_margin_right = 20.0
content_margin_bottom = 16.0

[node name="OptionsPanel" type="PanelContainer"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("panel_style")
script = ExtResource("1")

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Box"]
layout_mode = 2
text = "ROTATORS - OPTIONS"
horizontal_alignment = 1

[node name="Rows" type="VBoxContainer" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 2

[node name="Buttons" type="HBoxContainer" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
alignment = 1
theme_override_constants/separation = 12

[node name="Footer" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
modulate = Color(0.7, 0.75, 0.9, 1)
horizontal_alignment = 1

[node name="Keys" type="Label" parent="Box"]
layout_mode = 2
modulate = Color(0.7, 0.75, 0.9, 1)
text = "UP/DOWN select   LEFT/RIGHT change   ENTER activate   TAB/ESC close"
horizontal_alignment = 1
